{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "macOS": {
      "infoPlist": "Info.plist",
      "minimumSystemVersion": "12.0"
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Zeditor",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 20,
          "y": 18
        },
        "acceptFirstMouse": true,
        "center": true,
        "closable": true,
        "minimizable": true,
        "maximizable": true,
        "dragDropEnabled": true,
        "backgroundColor": "#21242b",
        "visible": false
      }
    ]
  }
}
